---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import BookCard from "@components/BookCard.astro";
import { type CollectionEntry, getCollection } from "astro:content";
import { slugify } from "@utils/slugify";

export const getStaticPaths = async () => {
    const allPosts = await getCollection("posts");
    const allBooks = await getCollection("books");
    const allTags = [
        ...allPosts.map((post) => post.data.tags),
        ...allBooks.map((book) => book.data.tags),
    ].flat();

    const slugMap = new Map<string, string>();
    for (const tag of allTags) {
        const slug = slugify(tag);
        if (!slugMap.has(slug)) {
            slugMap.set(slug, tag);
        }
    }

    const tagOptions = [...slugMap.entries()]
        .map(([slug, displayTag]) => ({ slug, displayTag }))
        .sort((a, b) => a.displayTag.localeCompare(b.displayTag));

    return [...slugMap.entries()].map(([slug, displayTag]) => {
        const filteredPosts = allPosts
            .filter((post) => post.data.tags.some((t) => slugify(t) === slug))
            .sort(
                (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
            );
        const filteredBooks = allBooks
            .filter((book) => book.data.tags.some((t) => slugify(t) === slug))
            .sort(
                (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
            );
        return {
            params: { tag: slug },
            props: {
                posts: filteredPosts,
                books: filteredBooks,
                displayTag,
                tagOptions,
            },
        };
    });
};

interface TagOption {
    slug: string;
    displayTag: string;
}

interface TagProps {
    posts: CollectionEntry<"posts">[];
    books: CollectionEntry<"books">[];
    displayTag: string;
    tagOptions: TagOption[];
}

const { posts, books, displayTag, tagOptions } = Astro.props as TagProps;
const { tag } = Astro.params;
---

<BaseLayout pageTitle={`Tag: ${displayTag}`}>
    <div class="flex flex-row text-ink items-center font-bold w-full font-mono text-sm mb-4">
        <label class="flex flex-row items-center gap-2">
            Tagged with
            <span class="inline-grid hard-shadow">
                <select
                    class="field-sizing-content font-mono text-sm font-semibold text-ink uppercase px-1 py-0 bg-secondary-bg border border-line cursor-pointer"
                    onchange="window.location = this.value"
                >
                    {tagOptions.map((option) => (
                        <option
                            value={`/tags/${option.slug}/`}
                            selected={option.slug === tag}
                        >
                            {option.displayTag.toUpperCase()}
                        </option>
                    ))}
                </select>
            </span>
        </label>
        <div class="flex-1 min-w-0 border-t ml-3 border-line h-0"></div>
    </div>
    <div class="flex flex-col gap-4">
        {posts.map((post) => (
            <ProjectCard post={post} />
        ))}
        {books.map((book) => (
            <BookCard book={book} />
        ))}
    </div>
</BaseLayout>
