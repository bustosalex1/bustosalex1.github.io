{
    "name": "website",
    "type": "module",
    "version": "0.8",
    "packageManager": "pnpm@9.4.0",
    "scripts": {
        "sync": "astro sync",
        "stamp": "echo \"COMMIT_HASH=$(git rev-parse --short HEAD)\"> .env && echo \"WEBSITE_VERSION=$(node -p \"require('./package.json').version\")\">>.env",
        "dev": "astro dev",
        "start": "astro dev",
        "build": "pnpm stamp && astro build",
        "preview": "astro preview",
        "astro": "astro",
        "format": "prettier . --write",
        "lint": "prettier --check . && eslint . && svelte-check --tsconfig ./tsconfig.json"
    },
    "dependencies": {
        "@fontsource/crimson-text": "^5.3.0",
        "@fontsource/fira-code": "^5.3.0",
        "@threlte/core": "^8.7.0",
        "@threlte/extras": "^9.23.1",
        "katex": "^0.16.47",
        "three": "^0.187.0"
    },
    "devDependencies": {
        "@astrojs/markdown-remark": "^7.3.6",
        "@astrojs/mdx": "^8.1.3",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@astrojs/svelte": "^9.1.2",
        "@astrojs/ts-plugin": "^1.10.12",
        "@eslint/js": "^10.0.1",
        "@iconify-json/carbon": "^1.2.30",
        "@iconify-json/line-md": "^1.2.16",
        "@iconify-json/material-symbols": "^1.2.98",
        "@iconify-json/octicon": "^1.2.40",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.5",
        "@types/eslint": "^9.6.1",
        "@types/hast": "^3.0.5",
        "@types/three": "^0.187.0",
        "astro": "^7.4.7",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-svelte": "^3.24.1",
        "globals": "^17.12.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "prettier-plugin-svelte": "^4.1.1",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "sharp": "^0.35.5",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "ultrahtml": "^1.7.0",
        "unist-util-visit": "^5.2.0",
        "unplugin-icons": "^24.0.0"
    }
}
